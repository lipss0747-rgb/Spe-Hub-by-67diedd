RS.RenderStepped:Connect(function()
    if not getgenv().AimlockEnabled then return end
    if getgenv().AimlockTarget == "" then return end

    if not LockedPlayer then
        LockedPlayer = FindTargetByName()
    end

    if LockedPlayer and LockedPlayer.Character then
        local targetPart = LockedPlayer.Character:FindFirstChild("Head") or LockedPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetPart then
            local direction = (targetPart.Position - Camera.CFrame.Position).Unit
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + direction)

            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.18)
        end
    end
end)


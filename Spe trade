local function GetLockedSky()
    local s = Lighting:FindFirstChild("SPE_LOCKED_SKY")
    if not s then
        for _,v in pairs(Lighting:GetChildren()) do
            if v:IsA("Sky") then
                v:Destroy()
            end
        end
        s = Instance.new("Sky")
        s.Name = "SPE_LOCKED_SKY"
        s.Parent = Lighting
    end
    return s
end

local function RemoveSkyEffects()
    for _,v in pairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect") or v:IsA("ColorCorrectionEffect") then
            v:Destroy()
        end
    end
end

local function ApplySkybox(name)
    local D = SkyData[name]
    if not D then return end

    getgenv().CurrentSkyName = name

    RemoveSkyEffects()

    local s = GetLockedSky()
    s.SkyboxBk = D.Sky.Bk
    s.SkyboxDn = D.Sky.Dn
    s.SkyboxFt = D.Sky.Ft
    s.SkyboxLf = D.Sky.Lf
    s.SkyboxRt = D.Sky.Rt
    s.SkyboxUp = D.Sky.Up

    Lighting.Ambient = D.Ambient
    Lighting.OutdoorAmbient = D.OutdoorAmbient
    Lighting.Brightness = D.Brightness
    Lighting.ClockTime = D.ClockTime
    Lighting.FogEnd = D.FogEnd
end

local function DisableSkybox()
    getgenv().CurrentSkyName = nil

    if Lighting:FindFirstChild("SPE_LOCKED_SKY") then
        Lighting.SPE_LOCKED_SKY:Destroy()
    end

    Lighting.Ambient = Color3.fromRGB(128,128,128)
    Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
    Lighting.Brightness = 2
    Lighting.ClockTime = 14
    Lighting.FogEnd = 100000
end

